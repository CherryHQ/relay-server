# Optional runtime overrides. Copy to runtime.env, which is gitignored.
# Full list: docs/runtime.md. The container listens on 0.0.0.0:8787.
RELAY_MAX_CONNECTIONS=512
RELAY_MAX_TARGETS=128
RELAY_MAX_SESSIONS=128
RELAY_MAX_SESSIONS_PER_TARGET=8
RELAY_MAX_SOCKET_BUFFER_BYTES=1048576
RELAY_MAX_TOTAL_BUFFER_BYTES=16777216
RELAY_DRAIN_MS=10000
# Keep drain + close grace below Compose's 30s stop_grace_period.
